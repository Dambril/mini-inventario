# Copia este archivo como .env y rellena los valores (Supabase → Project Settings → API Keys).
# SUPABASE_KEY debe ser la llave publishable (sb_publishable_…) o la anon legacy.
# Nunca pongas aquí la secret ni la service_role: el servidor se niega a arrancar con ellas.
SUPABASE_URL=
SUPABASE_KEY=
PORT=
